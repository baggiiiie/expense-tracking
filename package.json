{
  "name": "expense-tracking-flue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flue agents for the expense-tracking project (GitHub issue automation).",
  "scripts": {
    "eval": "vitest run --config .flue/evals/vitest.config.ts",
    "resolve-issue": "flue run .flue/agents/issue-resolver.ts --message 'Resolve the configured issue.'",
    "test": "node --test .flue/tests/resolve-issue.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@flue/runtime": "^2.0.2",
    "valibot": "latest"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.2",
    "agent-browser": "0.32.4",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
