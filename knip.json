{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "scripts/*.ts",
    "tests/*.test.ts",
    "evals/*.eval.ts",
    ".flue/agents/*.ts",
    ".flue/scripts/*.mjs",
    ".flue/tests/*.test.ts",
    ".flue/evals/*.eval.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "evals/**/*.ts", ".flue/**/*.{ts,mjs}"],
  "ignoreDependencies": ["agent-browser"],
  "ignoreBinaries": ["build", "go"]
}
